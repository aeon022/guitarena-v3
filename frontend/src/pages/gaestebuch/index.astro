---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guestbookFiles, parseGuestbookEntry } from '../../utils/guestbook';

const initialLimit = 20;
const allEntries = guestbookFiles
  .sort((a, b) => b.localeCompare(a))
  .map(parseGuestbookEntry);
const initialEntries = allEntries.slice(0, initialLimit);
const remainingEntries = allEntries.slice(initialLimit);
---

<BaseLayout title="Gästebuch">
  <div class="max-w-6xl mx-auto px-8 md:px-16 pt-32 pb-24">
    <header class="mb-20 border-b border-orten-border pb-12">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Historie</span>
      </div>
      <h1 class="text-7xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-orten-text mb-4">
        Gästebuch<span class="italic text-orten-amber">.</span>
      </h1>
      <p class="font-mono text-sm text-orten-muted uppercase tracking-widest mt-8">
        Ein Stück Geschichte. Signiert seit 1993.
      </p>
    </header>

    <div id="guestbook-container" class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
      {initialEntries.map(entry => (
        <div 
          class="guestbook-card break-inside-avoid relative group cursor-pointer overflow-hidden rounded-md bg-orten-card border border-orten-border shadow-xl reveal-on-scroll"
          data-guestbook-entry
          data-filename={entry.filename}
          data-artist={entry.artistName}
          data-year={entry.year}
        >
          <div class="absolute inset-0 bg-orten-amber/20 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          
          <img 
            src={`/images/guestbook/${entry.filename}`} 
            alt={`${entry.artistName} Gästebuch`} 
            class="w-full h-auto object-cover sepia-[.30] group-hover:sepia-0 group-hover:scale-[1.03] transition-all duration-700"
            loading="lazy"
          />
          
          <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-orten-bg/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-20">
            <span class="text-orten-amber font-mono text-xs uppercase tracking-widest bg-orten-bg/80 backdrop-blur-sm px-2 py-1 border border-orten-border">
              {entry.artistName}, {entry.year}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Lightbox Modal -->
    <div id="guestbook-modal" class="fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-xl bg-orten-bg/90">
      <button id="modal-prev" class="absolute left-4 md:left-8 text-orten-text/30 hover:text-orten-amber transition-colors z-[110] p-4 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      
      <button id="modal-next" class="absolute right-4 md:right-8 text-orten-text/30 hover:text-orten-amber transition-colors z-[110] p-4 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <button id="modal-close" class="absolute top-8 right-8 text-orten-text/50 hover:text-orten-amber transition-colors z-[110] cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      
      <div class="relative max-w-5xl w-full max-h-[90vh] p-4 flex flex-col items-center">
        <img id="modal-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain shadow-2xl rounded-sm border border-white/5 scale-95 transition-all duration-500 ease-out" />
        
        <div class="mt-8 text-center">
          <h3 id="modal-artist" class="text-3xl font-serif text-orten-text mb-2"></h3>
          <p id="modal-year" class="font-mono text-xs uppercase tracking-[0.3em] text-orten-amber"></p>
        </div>
      </div>
    </div>

    <div id="load-more-trigger" class="h-40 flex items-center justify-center mt-12">
      <div class="animate-pulse font-mono text-[10px] uppercase tracking-[0.3em] text-orten-muted/30 italic">Blättere in der Geschichte...</div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ remainingEntries }}>
  let loadedCount = 0;
  const CHUNK_SIZE = 12;
  const container = document.getElementById('guestbook-container');
  const trigger = document.getElementById('load-more-trigger');
  
  // Modal Elements
  const modal = document.getElementById('guestbook-modal');
  const modalImg = document.getElementById('modal-img');
  const modalArtist = document.getElementById('modal-artist');
  const modalYear = document.getElementById('modal-year');
  const closeBtn = document.getElementById('modal-close');
  const prevBtn = document.getElementById('modal-prev');
  const nextBtn = document.getElementById('modal-next');

  let currentEntries = [];
  let currentIndex = 0;

  const updateModalContent = (index) => {
    currentEntries = Array.from(document.querySelectorAll('[data-guestbook-entry]'));
    const entry = currentEntries[index];
    if (!entry || !modalImg) return;
    
    modalImg.style.opacity = '0';
    modalImg.style.transform = 'scale(0.98)';
    
    setTimeout(() => {
      modalImg.src = `/images/guestbook/${entry.dataset.filename}`;
      modalArtist.textContent = entry.dataset.artist;
      modalYear.textContent = entry.dataset.year;
      modalImg.style.opacity = '1';
      modalImg.style.transform = 'scale(1)';
    }, 200);
    
    currentIndex = index;
  };

  const openModal = (entry, index) => {
    currentEntries = Array.from(document.querySelectorAll('[data-guestbook-entry]'));
    currentIndex = index;
    
    const { filename, artist, year } = entry.dataset;
    modalImg.src = `/images/guestbook/${filename}`;
    modalArtist.textContent = artist;
    modalYear.textContent = year;

    modal.classList.remove('opacity-0', 'pointer-events-none');
    setTimeout(() => modalImg.classList.add('scale-100'), 10);
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modalImg) return;
    modalImg.classList.remove('scale-100');
    modal.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  };

  // Reveal Logic
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('active');
    });
  }, { threshold: 0.1 });

  const initEntries = () => {
    const entries = document.querySelectorAll('[data-guestbook-entry]');
    entries.forEach((el, i) => {
      observer.observe(el);
      if (!el.dataset.bound) {
        el.addEventListener('click', () => openModal(el, i));
        el.dataset.bound = 'true';
      }
    });
  };

  const createItem = (entry) => {
    const div = document.createElement('div');
    div.className = "guestbook-card break-inside-avoid relative group cursor-pointer overflow-hidden rounded-md bg-orten-card border border-orten-border shadow-xl reveal-on-scroll";
    div.dataset.guestbookEntry = "";
    div.dataset.filename = entry.filename;
    div.dataset.artist = entry.artistName;
    div.dataset.year = entry.year;
    
    div.innerHTML = `
      <div class="absolute inset-0 bg-orten-amber/20 mix-blend-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
      <img src="/images/guestbook/${entry.filename}" alt="${entry.artistName} Gästebuch" class="w-full h-auto object-cover sepia-[.30] group-hover:sepia-0 group-hover:scale-[1.03] transition-all duration-700" loading="lazy" />
      <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-orten-bg/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-20">
        <span class="text-orten-amber font-mono text-xs uppercase tracking-widest bg-orten-bg/80 backdrop-blur-sm px-2 py-1 border border-orten-border">
          ${entry.artistName}, ${entry.year}
        </span>
      </div>
    `;
    return div;
  };

  const loadMore = () => {
    if (loadedCount >= remainingEntries.length) {
      if (trigger) trigger.style.display = 'none';
      return;
    }
    const nextChunk = remainingEntries.slice(loadedCount, loadedCount + CHUNK_SIZE);
    nextChunk.forEach(entry => {
      container.appendChild(createItem(entry));
    });
    loadedCount += CHUNK_SIZE;
    initEntries();
  };

  const scrollObserver = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '600px' });

  if (trigger) scrollObserver.observe(trigger);
  
  // Modal Navigation & Controls
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (prevBtn) prevBtn.addEventListener('click', () => updateModalContent((currentIndex - 1 + currentEntries.length) % currentEntries.length));
  if (nextBtn) nextBtn.addEventListener('click', () => updateModalContent((currentIndex + 1) % currentEntries.length));
  
  if (modal) {
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft' && prevBtn) prevBtn.click();
    if (e.key === 'ArrowRight' && nextBtn) nextBtn.click();
  });

  initEntries();
  document.addEventListener('astro:after-swap', initEntries);
</script>

<style is:global>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal-on-scroll.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .guestbook-card {
    will-change: transform, opacity;
  }
</style>
