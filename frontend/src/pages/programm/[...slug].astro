---
import { getCollection, getEntry, render } from 'astro:content';
import ConsentYouTubeEmbed from '../../components/ConsentYouTubeEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, formatTime } from '../../utils/date';

export async function getStaticPaths() {
  const events = await getCollection('events');

  return events.map((event) => ({
    params: { slug: event.id },
  }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  return Astro.redirect('/404');
}

const event = await getEntry('events', slug);

if (!event) {
  return Astro.redirect('/404');
}

const { title, date, location, image, video } = event.data;
const { Content } = await render(event);

// Split title
const titleParts = title.split(' ');
const firstName = titleParts[0];
const lastName = titleParts.slice(1).join(' ');

// Media Logic
const isYouTube = video?.includes('youtube.com') || video?.includes('youtu.be');
let youtubeId = '';
if (isYouTube && video) {
  const match = video.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^&?]+)/);
  youtubeId = match ? match[1] : '';
}

const backgroundImage = image?.startsWith('http') 
  ? image 
  : image 
    ? import.meta.env.BASE_URL + `images/events/${image}` 
    : import.meta.env.BASE_URL + `images/hero.webp`;
    
const imageUrl = image?.startsWith('http') ? image : import.meta.env.BASE_URL + `images/events/${image}`;
---

<BaseLayout title={title}>
  <article class="relative min-h-screen">
    
    <!-- Dynamic Hero Section (Always Dark) -->
    <section data-dark-bg class="relative h-[70vh] md:h-[85vh] flex flex-col justify-end overflow-hidden bg-[#110e0d]">
      <div id="detail-fallback" class="absolute inset-0 bg-cover bg-center opacity-30 mix-blend-luminosity z-0" style={`background-image: url('${backgroundImage}')`}></div>

      {video && (
        <div id="detail-video-container" class:list={[
          "absolute inset-0 z-0 overflow-hidden opacity-40 mix-blend-luminosity",
          isYouTube ? "pointer-events-auto" : "pointer-events-none",
        ]}>
          {isYouTube ? (
            <ConsentYouTubeEmbed
              youtubeId={youtubeId}
              title={`${title} Video`}
              containerClass="pointer-events-auto opacity-70 mix-blend-luminosity"
              iframeClass="absolute top-1/2 left-1/2 h-[120vh] w-[120vw] -translate-x-1/2 -translate-y-1/2 object-cover"
            />
          ) : (
            <video id="detail-video" autoplay muted loop playsinline class="absolute top-1/2 left-1/2 min-w-full min-h-full -translate-x-1/2 -translate-y-1/2 object-cover">
              <source src={video} type="video/mp4" />
            </video>
          )}
        </div>
      )}

      <div class="absolute inset-0 bg-gradient-to-t from-[#110e0d] via-[#110e0d]/40 to-transparent z-5"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#110e0d]/50 via-transparent to-transparent z-5"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#110e0d]/20 to-[#110e0d] opacity-90 z-5"></div>

      <div class="relative z-10 max-w-6xl mx-auto w-full px-8 md:px-16 pb-16">
        <a href={import.meta.env.BASE_URL + "programm"} class="group inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-white/60 hover:text-orten-amber transition-colors mb-12">
          <span class="group-hover:-translate-x-1 transition-transform">←</span> Zurück zum Programm
        </a>
        <div class="flex items-center gap-4 mb-8">
          <span class="w-12 h-[1px] bg-orten-amber"></span>
          <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Konzert-Details</span>
        </div>
        <h1 class="text-7xl md:text-[9rem] font-serif leading-[0.9] tracking-tight mb-8 text-[#f0ebe1] drop-shadow-2xl">{firstName}<br><span class="italic text-[#f0ebe1]/90">{lastName}</span></h1>
        <div class="flex flex-col md:flex-row gap-8 md:gap-16 font-mono text-xs uppercase tracking-widest text-[#f0ebe1]/50 border-t border-white/5 pt-12">
          <div class="flex flex-col gap-2"><span class="text-orten-amber">Datum /</span><time datetime={date.toISOString()} class="text-[#f0ebe1] text-sm">{formatDate(date)}</time></div>
          <div class="flex flex-col gap-2"><span class="text-orten-amber">Beginn /</span><span class="text-[#f0ebe1] text-sm">19:30 Uhr</span></div>
          <div class="flex flex-col gap-2"><span class="text-orten-amber">Ort /</span><span class="text-[#f0ebe1] text-sm">{location.split(',')[0]}</span></div>
        </div>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-8 md:px-16 py-24 bg-orten-bg">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-24 items-start">
        <div class="md:col-span-2">
          <div class="prose prose-orten max-w-none prose-lg md:prose-xl text-orten-text">
            <Content />
          </div>

          {video && image && (
            <div class="mt-16 pt-16 border-t border-orten-border">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-muted block mb-8">Impression</span>
              <div class="aspect-video bg-orten-card rounded-3xl overflow-hidden relative group shadow-2xl border border-orten-border">
                <div class="absolute inset-0 bg-orten-amber/5 mix-blend-overlay z-10 pointer-events-none"></div>
                <img src={imageUrl} alt={title} class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000" />
              </div>
            </div>
          )}
        </div>

        <aside class="sticky top-32">
          <div class="bg-orten-card/30 backdrop-blur-sm p-10 rounded-3xl border border-orten-border/50 shadow-xl relative overflow-hidden group transition-all duration-500 hover:shadow-orten-amber/5 hover:bg-orten-card/50">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-orten-amber/5 rounded-full blur-3xl group-hover:bg-orten-amber/15 transition-all duration-700"></div>
            
            <h3 class="font-serif text-2xl text-orten-text mb-2">Reservierung</h3>
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber mb-6">Ortenburgerkeller</p>
            
            <p class="text-sm text-orten-muted leading-relaxed mb-10 font-light italic">
              Erleben Sie die Weltelite der Gitarrenmusik im intimen Rahmen des historischen Schlosses.
            </p>
            
            <a href="mailto:karten@porcia.at" class="group relative flex items-center justify-center w-full py-5 rounded-full border border-orten-text/20 hover:border-orten-amber hover:bg-orten-amber transition-all duration-500 ease-out overflow-hidden">
              <span class="font-mono text-xs uppercase tracking-[0.2em] group-hover:text-[#110e0d] transition-colors font-bold z-10 text-orten-text">Tickets</span>
              <div class="absolute inset-0 bg-orten-amber translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
            </a>
            
            <div class="mt-12 pt-8 border-t border-orten-border/50">
              <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3 text-[10px] font-mono text-orten-muted uppercase tracking-[0.2em]">
                  <span class="text-orten-amber">Einlass /</span>
                  <span>19:00 Uhr</span>
                </div>
                <div class="flex items-center gap-3 text-[10px] font-mono text-orten-muted uppercase tracking-[0.2em]">
                  <span class="text-orten-amber">Beginn /</span>
                  <span>19:30 Uhr</span>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const initDetailHero = () => {
    const fallback = document.getElementById('detail-fallback');
    const video = document.getElementById('detail-video') as HTMLVideoElement;
    const iframe = document.querySelector('#detail-video-container iframe') as HTMLIFrameElement;
    if (fallback) {
      if (video) {
        video.addEventListener('playing', () => fallback.style.opacity = '0');
        if (video.readyState >= 3) fallback.style.opacity = '0';
      }
      if (iframe) {
        iframe.addEventListener('load', () => setTimeout(() => fallback.style.opacity = '0', 1500));
      }
    }
  };
  initDetailHero();
  document.addEventListener('astro:after-swap', initDetailHero);
  document.addEventListener('guitarena:youtube-loaded', initDetailHero);
</script>
