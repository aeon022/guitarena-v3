---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import TicketInfo from '../../components/TicketInfo.astro';
import { isUpcoming, seasonYear } from '../../utils/date';
import { stripMarkdown } from '../../utils/seo';

const allEvents = await getCollection('events');
const currentYear = seasonYear(allEvents.map((event) => event.data.date));
const currentYearEvents = allEvents
  .filter((event) => event.data.date.getFullYear() === currentYear)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const upcomingEvents = currentYearEvents.filter(event => isUpcoming(event.data.date));
const site = Astro.site ?? new URL('https://guitarena.at');
const structuredData = upcomingEvents.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Guitarena Programm ${currentYear}`,
  itemListElement: upcomingEvents.map((event, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/programm/${event.id}/`, site).toString(),
    name: event.data.title,
  })),
} : undefined;
const pastEvents = currentYearEvents.filter(event => !isUpcoming(event.data.date)).reverse();
---

<BaseLayout
  title={`Programm ${currentYear}`}
  description={`Alle Guitarena-Konzerte ${currentYear} im Ortenburgerkeller von Schloss Porcia in Spittal an der Drau. Termine, Künstler und Ticketinfos im Überblick.`}
  image="/images/hero.webp"
  structuredData={structuredData}
>
  <div class="max-w-6xl mx-auto px-8 md:px-16 pt-32 landscape:pt-28 md:pt-32 pb-24 landscape:pb-16">
    <header class="mb-20 landscape:mb-12 border-b border-orten-border pb-12 landscape:pb-8">
      <div class="flex items-center gap-4 mb-8 landscape:mb-5">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Programm {currentYear}</span>
      </div>
      <h1 class="text-7xl landscape:text-5xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-orten-text mb-4 landscape:mb-2 landscape:whitespace-nowrap">
        Programm<span class="italic text-orten-amber">.</span>
      </h1>
      <p class="font-mono text-sm landscape:text-xs text-orten-muted uppercase tracking-widest mt-8 landscape:mt-4">
        Handgemachte Musik im Ortenburgerkeller
      </p>
    </header>

    {upcomingEvents.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 landscape:gap-6 md:gap-16">
        {upcomingEvents.map(event => (
          <EventCard event={{ id: event.id, ...event.data, body: stripMarkdown(event.body ?? '') }} />
        ))}
      </div>
    )}

    {upcomingEvents.length > 0 && <TicketInfo />}

    {upcomingEvents.length === 0 && (
      <div class="py-32 text-center bg-orten-card border border-orten-border rounded-3xl shadow-2xl">
        <p class="font-serif text-3xl text-orten-muted italic">Aktuell sind keine kommenden Konzerte geplant.</p>
        <p class="font-mono text-[10px] text-orten-muted/50 uppercase tracking-[0.3em] mt-8">Das nächste Programm folgt in Kürze — schau bald wieder vorbei</p>
        <a href={import.meta.env.BASE_URL + 'archiv/'} class="inline-block mt-8 font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber hover:underline">Zum Konzertarchiv &rarr;</a>
      </div>
    )}

    {pastEvents.length > 0 && (
      <section class="mt-24 landscape:mt-16 pt-12 border-t border-orten-border">
        <div class="flex items-center gap-4 mb-12 landscape:mb-8">
          <span class="w-12 h-[1px] bg-orten-muted/50"></span>
          <h2 class="text-orten-muted font-mono text-xs uppercase tracking-[0.3em]">Vergangene Konzerte {currentYear}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 landscape:gap-6 md:gap-16">
          {pastEvents.map(event => (
            <EventCard event={{ id: event.id, ...event.data, body: stripMarkdown(event.body ?? '') }} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
