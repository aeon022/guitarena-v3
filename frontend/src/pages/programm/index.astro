---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import TicketInfo from '../../components/TicketInfo.astro';
import { isUpcoming } from '../../utils/date';

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(event => isUpcoming(event.data.date))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<BaseLayout title="Programm">
  <div class="max-w-6xl mx-auto px-8 md:px-16 pt-32 pb-24">
    <header class="mb-20 border-b border-orten-border pb-12">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Nächste Konzerte</span>
      </div>
      <h1 class="text-7xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-orten-text mb-4">
        Programm<span class="italic text-orten-amber">.</span>
      </h1>
      <p class="font-mono text-sm text-orten-muted uppercase tracking-widest mt-8">
        Handgemachte Musik im Ortenburgerkeller
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      {upcomingEvents.map(event => (
        <EventCard event={{ id: event.id, ...event.data }} />
      ))}
    </div>

    {upcomingEvents.length > 0 && <TicketInfo />}
    
    {upcomingEvents.length === 0 && (
      <div class="py-32 text-center bg-orten-card border border-orten-border rounded-3xl shadow-2xl">
        <p class="font-serif text-3xl text-orten-muted italic">Aktuell sind keine kommenden Konzerte geplant.</p>
        <p class="font-mono text-[10px] text-orten-muted/50 uppercase tracking-[0.3em] mt-8">Schau bald wieder vorbei</p>
      </div>
    )}
  </div>
</BaseLayout>
