---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isUpcoming, formatDate } from '../../utils/date';
import { getResponsiveImage } from '../../utils/responsiveImages';

const allEvents = await getCollection('events');
const pastEvents = allEvents
  .filter(event => !isUpcoming(event.data.date))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Archiv"
  description="Das Konzertarchiv der Guitarena mit vergangenen Auftritten internationaler Gitarristinnen und Gitarristen seit 1998 im Ortenburgerkeller."
  image="/images/about.webp"
>
  <div class="max-w-6xl mx-auto px-8 md:px-16 pt-32 landscape:pt-28 md:pt-32 pb-24 landscape:pb-16">
    <header class="mb-20 landscape:mb-12 border-b border-orten-border pb-12 landscape:pb-8">
      <div class="flex items-center gap-4 mb-8 landscape:mb-5">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Unsere Geschichte</span>
      </div>
      <h1 class="text-7xl landscape:text-5xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-orten-text mb-4 landscape:mb-2 landscape:whitespace-nowrap">
        Archiv<span class="italic text-orten-amber">.</span>
      </h1>
      <p class="font-mono text-sm landscape:text-xs text-orten-muted uppercase tracking-widest mt-8 landscape:mt-4 italic">
        Internationale Weltelite seit 1998
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 landscape:gap-6 auto-rows-[280px] landscape:auto-rows-[220px]">
      {pastEvents.map((event, index) => {
        const { title, date, body, image } = event.data;
        const imageUrl = image ? (image.startsWith('http') ? image : `/images/events/${image}`) : null;
        const imageProps = getResponsiveImage(imageUrl, index % 4 === 0 ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 100vw');
        const isHighlight = index % 4 === 0 || index % 7 === 0;

        return (
          <article 
            class={`
              relative bg-orten-card border border-orten-border rounded-3xl overflow-hidden flex flex-col justify-between group hover:border-orten-amber/30 transition-all duration-700 shadow-xl
              ${index % 4 === 0 ? 'md:col-span-2 md:row-span-2' : ''}
              ${index % 7 === 0 ? 'md:row-span-2' : ''}
            `}
          >
            <!-- Background Image for Highlights or subtle overlay for others -->
            {imageUrl && (
              <div class={`absolute inset-0 z-0 transition-all duration-1000 ${isHighlight ? 'opacity-20 group-hover:opacity-40 scale-105 group-hover:scale-100' : 'opacity-0 group-hover:opacity-10'}`}>
                <img src={imageProps?.src} srcset={imageProps?.srcset} sizes={imageProps?.sizes} width={imageProps?.width} height={imageProps?.height} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover grayscale" />
                <div class="absolute inset-0 bg-gradient-to-t from-orten-card via-orten-card/60 to-transparent"></div>
              </div>
            )}

            <div class="relative z-10 p-8 landscape:p-6">
              <div class="flex items-center justify-between mb-4 landscape:mb-3">
                <span class="text-[10px] font-mono font-bold text-orten-muted uppercase tracking-[0.2em] group-hover:text-orten-amber transition-colors">
                  {formatDate(date)}
                </span>
                <span class="w-8 h-[1px] bg-orten-border group-hover:bg-orten-amber/30 transition-colors"></span>
              </div>
              
              <h3 class={`font-serif text-orten-text group-hover:text-orten-text transition-colors leading-tight mb-4 landscape:mb-3 ${index % 4 === 0 ? 'text-4xl landscape:text-3xl md:text-6xl' : 'text-2xl landscape:text-xl'}`}>
                {title}
              </h3>
              
              <p class="text-sm landscape:text-xs text-orten-muted font-light leading-relaxed line-clamp-3">
                {body}
              </p>
            </div>
            
            <div class="archive-card-actions relative z-10 p-8 landscape:p-6 flex justify-between items-center opacity-100 translate-y-0 transition-all duration-500">
               <a href={import.meta.env.BASE_URL + `programm/${event.id}/`} class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber font-bold italic">Details &rarr;</a>
               <div class="w-12 h-12 rounded-full border border-orten-border flex items-center justify-center text-orten-muted group-hover:border-orten-amber/30 group-hover:text-orten-amber transition-all">
                 🎸
               </div>
            </div>
            
            <!-- Background Decoration for larger cards -->
            {index % 4 === 0 && (
              <div class="absolute bottom-0 right-0 p-8 opacity-5 text-orten-text text-8xl font-serif pointer-events-none group-hover:opacity-10 transition-opacity">
                {date.getFullYear()}
              </div>
            )}
          </article>
        );
      })}
    </div>

    {pastEvents.length === 0 && (
      <div class="py-32 text-center border border-dashed border-orten-border rounded-3xl">
        <p class="font-serif text-2xl text-orten-muted italic">Die Geschichte wird gerade erst geschrieben.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  @media (hover: hover) and (pointer: fine) {
    .archive-card-actions {
      opacity: 0;
      transform: translateY(0.5rem);
    }

    article.group:hover .archive-card-actions {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
