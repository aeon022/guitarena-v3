---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isUpcoming, formatDate } from '../../utils/date';

const allEvents = await getCollection('events');
const pastEvents = allEvents
  .filter(event => !isUpcoming(event.data.date))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Archiv">
  <div class="max-w-6xl mx-auto px-8 md:px-16 pt-32 pb-24">
    <header class="mb-20 border-b border-white/10 pb-12">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Unsere Geschichte</span>
      </div>
      <h1 class="text-7xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-white mb-4">
        Archiv<span class="italic text-orten-amber">.</span>
      </h1>
      <p class="font-mono text-sm text-white/50 uppercase tracking-widest mt-8 italic">
        Internationale Weltelite seit 1993
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 auto-rows-[280px]">
      {pastEvents.map((event, index) => {
        const { title, date, body, image } = event.data;
        const imageUrl = image ? (image.startsWith('http') ? image : `/images/events/${image}`) : null;
        const isHighlight = index % 4 === 0 || index % 7 === 0;

        return (
          <article 
            class={`
              relative bg-orten-card border border-white/5 rounded-3xl overflow-hidden flex flex-col justify-between group hover:border-orten-amber/30 transition-all duration-700 shadow-xl
              ${index % 4 === 0 ? 'md:col-span-2 md:row-span-2' : ''}
              ${index % 7 === 0 ? 'md:row-span-2' : ''}
            `}
          >
            <!-- Background Image for Highlights or subtle overlay for others -->
            {imageUrl && (
              <div class={`absolute inset-0 z-0 transition-all duration-1000 ${isHighlight ? 'opacity-20 group-hover:opacity-40 scale-105 group-hover:scale-100' : 'opacity-0 group-hover:opacity-10'}`}>
                <img src={imageUrl} alt="" class="w-full h-full object-cover grayscale" />
                <div class="absolute inset-0 bg-gradient-to-t from-orten-card via-orten-card/60 to-transparent"></div>
              </div>
            )}

            <div class="relative z-10 p-8">
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] font-mono font-bold text-white/30 uppercase tracking-[0.2em] group-hover:text-orten-amber transition-colors">
                  {formatDate(date)}
                </span>
                <span class="w-8 h-[1px] bg-white/10 group-hover:bg-orten-amber/30 transition-colors"></span>
              </div>
              
              <h3 class={`font-serif text-white group-hover:text-white transition-colors leading-tight mb-4 ${index % 4 === 0 ? 'text-4xl md:text-6xl' : 'text-2xl'}`}>
                {title}
              </h3>
              
              <p class="text-sm text-white/40 font-light leading-relaxed line-clamp-3">
                {body}
              </p>
            </div>
            
            <div class="relative z-10 p-8 flex justify-between items-center opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-y-2 group-hover:translate-y-0">
               <a href={`/programm/${event.id}`} class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber font-bold italic">Rückblick &rarr;</a>
               <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-white/20 group-hover:border-orten-amber/30 group-hover:text-orten-amber transition-all">
                 🎸
               </div>
            </div>
            
            <!-- Background Decoration for larger cards -->
            {index % 4 === 0 && (
              <div class="absolute bottom-0 right-0 p-8 opacity-5 text-8xl font-serif pointer-events-none group-hover:opacity-10 transition-opacity">
                {date.getFullYear()}
              </div>
            )}
          </article>
        );
      })}
    </div>

    {pastEvents.length === 0 && (
      <div class="py-32 text-center border border-dashed border-white/5 rounded-3xl">
        <p class="font-serif text-2xl text-white/30 italic italic">Die Geschichte wird gerade erst geschrieben.</p>
      </div>
    )}
  </div>
</BaseLayout>
