---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConsentExternalEmbed from '../components/ConsentExternalEmbed.astro';
import Social from '../components/Social.astro';
---

<BaseLayout
  title="Kontakt & Anfahrt"
  description="Kontakt, Kartenreservierung und Anfahrt zur Guitarena im Ortenburgerkeller von Schloss Porcia in Spittal an der Drau."
  image="/images/about.webp"
>
  <main class="pt-32 pb-24 px-8 md:px-16 max-w-7xl mx-auto">
    
    <!-- Header Section -->
    <header class="mb-20 max-w-4xl">
      <div class="flex items-center gap-4 mb-8">
        <span class="w-12 h-[1px] bg-orten-amber"></span>
        <span class="text-orten-amber font-mono text-xs uppercase tracking-[0.3em]">Kontakt</span>
      </div>
      <h1 class="text-6xl md:text-[8rem] font-serif leading-[0.9] tracking-tight text-orten-text mb-12">
        Anfahrt & <span class="italic text-orten-amber">Kontakt</span>
      </h1>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Contact Info -->
      <div class="lg:col-span-5 space-y-12">
        <div class="bg-orten-card p-10 md:p-16 rounded-3xl border border-orten-border shadow-2xl relative overflow-hidden group">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-orten-amber/5 rounded-full blur-3xl group-hover:bg-orten-amber/15 transition-all duration-700"></div>
          
          <div class="relative z-10 space-y-12">
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber mb-6">Adresse</h3>
              <div class="text-orten-text leading-tight">
                <p class="text-3xl md:text-4xl font-serif mb-2">Guitarena</p>
                <p class="text-xl md:text-2xl font-serif opacity-80">
                  Schloss Porcia<br>
                  Burgplatz 1<br>
                  9800 Spittal an der Drau
                </p>
              </div>
            </div>

            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber mb-6">Direkter Kontakt</h3>
              <a href="mailto:hallo@guitarena.at" class="text-xl md:text-2xl font-serif text-orten-text hover:text-orten-amber transition-colors italic border-b border-orten-border pb-2 block w-fit">
                hallo@guitarena.at
              </a>
              <p class="text-xs text-orten-muted mt-4 font-mono uppercase tracking-widest">Hartwig Weiher</p>
            </div>

            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber mb-6">Kartenreservierung</h3>
              <a href="mailto:karten@porcia.at" class="text-xl md:text-2xl font-serif text-orten-text hover:text-orten-amber transition-colors italic border-b border-orten-border pb-2 block w-fit">
                karten@porcia.at
              </a>
              <p class="text-xs text-orten-muted mt-4 font-mono uppercase tracking-widest">Porcia Kartenbüro</p>
            </div>

            <div class="pt-8 border-t border-orten-border">
              <Social />
            </div>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="lg:col-span-7 h-full min-h-[500px]">
        <div class="w-full h-full rounded-3xl overflow-hidden border border-orten-border shadow-2xl relative group bg-orten-card">
          <!-- Custom Map Styling Filter Overlay -->
          <div class="absolute inset-0 z-10 pointer-events-none mix-blend-color bg-orten-bg/20"></div>
          
          <ConsentExternalEmbed
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2731.341424343144!2d13.49555137688142!3d46.79758197113114!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4770990df06ba99b%3A0x496ce0fc9df0600a!2sSchloss%20Porcia!5e0!3m2!1sde!2sat!4v1712260000000!5m2!1sde!2sat"
            title="Google Maps Anfahrt zu Schloss Porcia"
            headline="Karte aktivieren"
            description="Mit dem Laden der Karte können personenbezogene Daten an Google übertragen werden. Die Karte wird erst nach Ihrer Zustimmung angezeigt."
            acceptLabel="Karte laden"
            containerClass="pointer-events-auto"
            iframeClass="h-full w-full transition-all duration-1000 group-hover:opacity-100"
          />
          
          <div class="absolute bottom-8 left-8 z-20 bg-orten-bg/90 backdrop-blur-md border border-orten-border px-6 py-3 rounded-full shadow-xl">
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber italic">Anfahrt / Ortenburgerkeller</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Additional Info -->
    <section class="mt-32 pt-16 border-t border-orten-border" data-dark-bg>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center bg-[#110e0d] p-12 md:p-24 rounded-[3rem] text-white">
            <div>
                <h2 class="text-4xl md:text-5xl font-serif mb-6 leading-tight">Besuchen Sie uns im <span class="italic text-orten-amber">historischen Ambiente.</span></h2>
                <p class="text-white/60 font-light leading-relaxed max-w-md">Der Ortenburgerkeller befindet sich direkt unter dem Schloss Porcia. Parkplätze finden Sie in unmittelbarer Nähe im Stadtzentrum von Spittal.</p>
            </div>
            <div class="aspect-video rounded-2xl overflow-hidden border border-white/10">
                <img src={import.meta.env.BASE_URL + "images/hero.webp"} alt="Ortenburgerkeller" class="w-full h-full object-cover opacity-50 grayscale" />
            </div>
        </div>
    </section>

  </main>
</BaseLayout>
