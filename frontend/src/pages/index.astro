---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import EventLineup from '../components/EventLineup.astro';
import Guestbook from '../components/Guestbook.astro';
import { isUpcoming } from '../utils/date';

const allEvents = await getCollection('events');
const upcomingEvents = allEvents
  .filter(event => isUpcoming(event.data.date))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const nextEvent = upcomingEvents[0];
const otherUpcoming = upcomingEvents.slice(1);
---

<BaseLayout title="Home">
  {nextEvent && <Hero event={{ id: nextEvent.id, ...nextEvent.data }} />}
  
  <Intro />

  {upcomingEvents.length > 0 && (
    <EventLineup events={upcomingEvents.map(e => ({ id: e.id, ...e.data }))} />
  )}

  <Guestbook limit={10} />
</BaseLayout>
