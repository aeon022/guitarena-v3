---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import CookieConsent from '../components/CookieConsent.astro';
import Social from '../components/Social.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Guitarena - Ortenburgerkeller Spittal/Drau" } = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "favicon-32x32.png"} />
		<link rel="apple-touch-icon" href={import.meta.env.BASE_URL + "apple-touch-icon.png"} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Guitarena</title>
		<meta name="description" content={description} />
		<ClientRouter />
		<script is:inline>
			const applyTheme = () => {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return 'dark';
					}
					return 'light';
				})();
			
				if (theme === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}
				window.localStorage.setItem('theme', theme);
			};

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body class="min-h-screen flex flex-col selection:bg-orten-amber selection:text-orten-bg">
		
		<header id="main-header" class="w-full px-8 py-8 md:px-16 flex justify-between items-center fixed top-0 z-50 transition-all duration-500 ease-in-out">
			<a href={import.meta.env.BASE_URL} class="header-logo group flex items-baseline text-xl font-bold tracking-tighter uppercase drop-shadow-md">
				<span class="flex overflow-hidden">
					{"Guitarena".split("").map((char, i) => (
						<span class="inline-block transition-transform duration-500 ease-out group-hover:-translate-y-1" style={`transition-delay: ${i * 30}ms`}>
							{char}
						</span>
					))}
				</span>
				<span class="text-orten-amber inline-block animate-pulse-slow ml-px">.</span>
			</a>
			<div class="flex items-center gap-8">
				<nav class="hidden md:flex gap-8 font-mono text-xs uppercase tracking-[0.2em] drop-shadow-md">
					<a href={import.meta.env.BASE_URL + "programm"} class="transition-colors">Programm</a>
					<a href={import.meta.env.BASE_URL + "gaestebuch"} class="transition-colors">Gästebuch</a>
					<a href={import.meta.env.BASE_URL + "archiv"} class="transition-colors">Archiv</a>
					<a href={import.meta.env.BASE_URL + "about"} class="transition-colors">Über Uns</a>
				</nav>
				
				<div id="theme-switcher-container" class="flex items-center border border-orten-border rounded-full px-2 py-1 gap-1 transition-colors bg-black/5 backdrop-blur-sm shadow-sm">
					<button id="theme-light" class="p-1 rounded-full hover:bg-orten-text/10 transition-colors" title="Light Mode">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
					</button>
					<button id="theme-dark" class="p-1 rounded-full hover:bg-orten-text/10 transition-colors" title="Dark Mode">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
					</button>
					<button id="theme-system" class="p-1 rounded-full hover:bg-orten-text/10 transition-colors" title="System Settings">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
					</button>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="bg-orten-card pt-24 pb-12 px-8 md:px-16 border-t border-orten-border">
			<div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12 border-b border-orten-border pb-16">
				<div class="flex items-start gap-6">
					<div class="relative group">
						<img 
							src={import.meta.env.BASE_URL + "footer-guitar.png"} 
							alt="Guitarena Logo" 
							class="w-16 h-16 object-contain opacity-80 group-hover:opacity-100 transition-all duration-700 animate-float group-hover:scale-110 group-hover:[filter:drop-shadow(0_0_15px_rgba(232,139,58,0.4))]"
						/>
					</div>
					<div>
						<a href={import.meta.env.BASE_URL} class="footer-logo group flex items-baseline text-3xl font-serif tracking-tight mb-4 text-orten-text transition-colors">
							<span class="flex overflow-hidden">
								{"Guitarena".split("").map((char, i) => (
									<span class="inline-block transition-transform duration-500 ease-out group-hover:-translate-y-1" style={`transition-delay: ${i * 30}ms`}>
										{char}
									</span>
								))}
							</span>
							<span class="text-orten-amber inline-block animate-pulse-slow ml-px">.</span>
						</a>
						<p class="text-orten-text/80 font-light max-w-xs leading-relaxed">
							Kulturinitiative Spittal a. d. Drau.<br>
							Musik, die bleibt.
						</p>
					</div>
				</div>

				<div class="md:text-right">
					<p class="font-mono text-orten-muted text-xs mb-3 uppercase tracking-[0.2em]">Karten & Kontakt</p>
					<a href="mailto:karten@porcia.at" class="text-2xl md:text-3xl font-serif text-orten-text hover:text-orten-amber transition-colors italic">karten@porcia.at</a>
				</div>
			</div>
			
			<div class="max-w-6xl mx-auto mt-8 flex flex-col md:flex-row justify-between items-center font-mono text-xs uppercase tracking-widest text-orten-muted gap-4">
				<span>&copy; {new Date().getFullYear()} Guitarena</span>
				<Social />
				<div class="flex gap-8 text-[10px]">
					<a href={import.meta.env.BASE_URL + "impressum"} class="hover:text-orten-text transition-colors">Impressum</a>
					<a href={import.meta.env.BASE_URL + "datenschutz"} class="hover:text-orten-text transition-colors">Datenschutz</a>
					<a href={import.meta.env.BASE_URL + "cookies"} class="hover:text-orten-text transition-colors">Cookies</a>
					<button type="button" data-open-cookie-settings class="hover:text-orten-text transition-colors cursor-pointer">Cookie-Einstellungen</button>
				</div>
			</div>
		</footer>
		<CookieConsent />

		<script>
			const initHeader = () => {
				const header = document.getElementById('main-header');
				const themeContainer = document.getElementById('theme-switcher-container');
				
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							header?.classList.add('is-on-dark');
							themeContainer?.classList.remove('border-orten-border');
							themeContainer?.classList.add('border-white/20');
						} else {
							header?.classList.remove('is-on-dark');
							themeContainer?.classList.add('border-orten-border');
							themeContainer?.classList.remove('border-white/20');
						}
					});
				}, {
					rootMargin: '-80px 0px 0px 0px', // Trigger when header leaves/enters section
					threshold: 0
				});

				document.querySelectorAll('[data-dark-bg]').forEach(section => observer.observe(section));
			};

			const initThemeSwitcher = () => {
				const lightBtn = document.getElementById('theme-light');
				const darkBtn = document.getElementById('theme-dark');
				const systemBtn = document.getElementById('theme-system');

				const setTheme = (theme: 'light' | 'dark' | 'system') => {
					document.documentElement.classList.add('is-transitioning');
					
					if (theme === 'system') {
						localStorage.removeItem('theme');
						if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
							document.documentElement.classList.add('dark');
						} else {
							document.documentElement.classList.remove('dark');
						}
					} else {
						localStorage.setItem('theme', theme);
						if (theme === 'dark') {
							document.documentElement.classList.add('dark');
						} else {
							document.documentElement.classList.remove('dark');
						}
					}
					
					updateActiveButton();
					
					setTimeout(() => {
						document.documentElement.classList.remove('is-transitioning');
					}, 700);
				};

				const updateActiveButton = () => {
					const theme = localStorage.getItem('theme') || 'system';
					[lightBtn, darkBtn, systemBtn].forEach(btn => btn?.classList.remove('bg-white/20', 'bg-orten-text/10', 'text-orten-amber', 'text-orten-red'));
					
					const activeClass = document.documentElement.classList.contains('dark') ? 'text-orten-amber' : 'text-orten-red';
					const bgClass = document.documentElement.classList.contains('dark') ? 'bg-white/20' : 'bg-orten-text/10';

					if (theme === 'light') { lightBtn?.classList.add(bgClass, activeClass); }
					else if (theme === 'dark') { darkBtn?.classList.add(bgClass, activeClass); }
					else { systemBtn?.classList.add(bgClass, activeClass); }
				};

				lightBtn?.addEventListener('click', () => setTheme('light'));
				darkBtn?.addEventListener('click', () => setTheme('dark'));
				systemBtn?.addEventListener('click', () => setTheme('system'));

				updateActiveButton();

				// Listen for system theme changes if in system mode
				window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
					if (!localStorage.getItem('theme')) {
						if (e.matches) document.documentElement.classList.add('dark');
						else document.documentElement.classList.remove('dark');
						updateActiveButton();
					}
				});
			};

			initHeader();
			initThemeSwitcher();
			document.addEventListener('astro:after-swap', () => {
				initHeader();
				initThemeSwitcher();
			});
		</script>
	</body>
</html>
