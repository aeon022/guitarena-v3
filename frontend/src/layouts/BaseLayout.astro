---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Guitarena - Ortenburgerkeller Spittal/Drau" } = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=JetBrains+Mono:wght@400;700&family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Guitarena</title>
		<meta name="description" content={description} />
		<ViewTransitions />
	</head>
	<body class="min-h-screen flex flex-col selection:bg-orten-amber selection:text-orten-bg">
		
		<header class="w-full px-8 py-8 md:px-16 flex justify-between items-center fixed top-0 z-50 mix-blend-difference text-white">
			<a href="/" class="text-xl font-bold tracking-tighter uppercase">Guitarena<span class="text-orten-amber">.</span></a>
			<nav class="hidden md:flex gap-8 font-mono text-xs uppercase tracking-[0.2em]">
				<a href="/programm" class="hover:text-orten-amber transition-colors">Programm</a>
				<a href="/gaestebuch" class="hover:text-orten-amber transition-colors">Gästebuch</a>
				<a href="/archiv" class="hover:text-orten-amber transition-colors opacity-60">Archiv</a>
				<a href="/about" class="hover:text-orten-amber transition-colors">Über Uns</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="bg-orten-card pt-24 pb-12 px-8 md:px-16 border-t border-white/5">
			<div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12 border-b border-white/10 pb-16">
				<div>
					<div class="text-3xl font-serif tracking-tight mb-4 text-white">Guitarena<span class="text-orten-amber">.</span></div>
					<p class="text-white/50 font-light max-w-xs leading-relaxed">
						Kulturinitiative Spittal a. d. Drau.<br>
						Musik, die bleibt.
					</p>
				</div>
				<div class="md:text-right">
					<p class="font-mono text-white/30 text-xs mb-3 uppercase tracking-[0.2em]">Karten & Kontakt</p>
					<a href="mailto:karten@porcia.at" class="text-2xl md:text-3xl font-serif text-white hover:text-orten-amber transition-colors italic">karten@porcia.at</a>
				</div>
			</div>
			
			<div class="max-w-6xl mx-auto mt-8 flex flex-col md:flex-row justify-between items-center font-mono text-xs uppercase tracking-widest text-white/30 gap-4">
				<span>&copy; {new Date().getFullYear()} Guitarena</span>
				<div class="flex gap-8 text-[10px]">
					<a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
					<a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
				</div>
			</div>
		</footer>
	</body>
</html>
