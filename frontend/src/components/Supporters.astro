---
const supporters = [
  { name: 'AON', logo: 'supporters_AON.webp' },
  { name: 'Kelag Plus', logo: 'supporters_kelag-plus-neu.webp' },
  { name: 'Kulturamt Spittal', logo: 'supporters_Kulturamt_Spittal.webp' },
  { name: 'Schloss Porcia', logo: 'supporters_L1_Schloss-Porcia.webp' },
  { name: 'Land Kärnten', logo: 'supporters_Land_Kaernten.webp' },
  { name: 'Musik Aktiv', logo: 'supporters_Musik_Aktiv.webp' },
  { name: 'Volksbank', logo: 'supporters_Volksbank.webp' },
];
---

<section class="py-24 border-t border-orten-border overflow-hidden bg-orten-bg">
  <div class="max-w-6xl mx-auto px-8 md:px-16 mb-16 text-center">
    <h2 class="text-4xl font-serif text-orten-text mb-4">Partner & Unterstützer</h2>
    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-orten-muted">Gemeinsam für die Kultur in Spittal</p>
  </div>

  <div class="relative w-full inline-flex flex-nowrap overflow-hidden [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
    <ul class="flex items-center justify-center md:justify-start [&_li]:mx-8 md:[&_li]:mx-12 animate-infinite-scroll hover:[animation-play-state:paused]">
      {supporters.map(supporter => (
        <li class="flex-shrink-0 w-24 md:w-32 transition-all duration-700 hover:scale-110 group">
          <img 
            src={`/images/supporters/${supporter.logo}`} 
            alt={supporter.name}
            class="w-full h-auto object-contain grayscale opacity-40 group-hover:opacity-100 transition-all duration-700"
          />
        </li>
      ))}
    </ul>
    <!-- Duplicate for seamless loop -->
    <ul class="flex items-center justify-center md:justify-start [&_li]:mx-8 md:[&_li]:mx-12 animate-infinite-scroll hover:[animation-play-state:paused]" aria-hidden="true">
      {supporters.map(supporter => (
        <li class="flex-shrink-0 w-24 md:w-32 transition-all duration-700 hover:scale-110 group">
          <img 
            src={`/images/supporters/${supporter.logo}`} 
            alt={supporter.name}
            class="w-full h-auto object-contain grayscale opacity-40 group-hover:opacity-100 transition-all duration-700"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Local overrides if needed */
</style>
