---
// frontend/src/components/TicketInfo.astro
---
<section class="bg-orten-card/20 max-w-6xl w-full mx-auto px-8 md:px-16 py-16 rounded-2xl mt-24">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-4xl font-serif text-orten-text mb-8">Gut zu wissen</h2>
    
    <div class="text-orten-text/80 text-lg leading-relaxed space-y-6">
      <p>
        Einlass ist jeweils um <strong>19:00 Uhr</strong>, Beginn um <strong>19:30 Uhr</strong>.
      </p>
      <p>
        Kultur Card Kärnten, kelag Joker und Kulturpass sind gültig.
      </p>
      
      <div>
        <p class="font-bold">Kartenvorverkauf im Porcia Kartenbüro:</p>
        <p>Tel.: <a href="tel:+43476242020" class="text-orten-amber hover:underline">04762 / 42020</a></p>
        <p>E-Mail: <a href="mailto:karten@porcia.at" class="text-orten-amber hover:underline">karten@porcia.at</a></p>
      </div>

      <div class="flex flex-col md:flex-row justify-center items-center gap-8 pt-6">
        <div class="border border-orten-border p-6 rounded-lg">
          <p class="text-sm uppercase tracking-widest text-orten-muted">Erwachsene</p>
          <p class="text-3xl font-serif text-orten-amber mt-2">€ 18,00</p>
        </div>
        <div class="border border-orten-border p-6 rounded-lg">
          <p class="text-sm uppercase tracking-widest text-orten-muted">Ermäßigt</p>
          <p class="text-3xl font-serif text-orten-amber mt-2">€ 10,00</p>
          <p class="text-xs text-orten-muted mt-2">(Schüler, Studenten, Präsenz- & Zivildiener)</p>
        </div>
      </div>
    </div>
  </div>
</section>
