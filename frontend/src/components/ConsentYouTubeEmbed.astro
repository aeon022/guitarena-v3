---
import ConsentExternalEmbed from './ConsentExternalEmbed.astro';

interface Props {
  youtubeId: string;
  title: string;
  containerClass?: string;
  mediaClass?: string;
  iframeClass?: string;
}

const { youtubeId, title, containerClass = '', mediaClass = '', iframeClass = '' } = Astro.props;
const iframeSrc = `https://www.youtube.com/embed/${youtubeId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${youtubeId}&rel=0&showinfo=0&enablejsapi=1`;
---

<ConsentExternalEmbed
  src={iframeSrc}
  title={title}
  headline="YouTube-Video aktivieren"
  description="Mit dem Laden des Videos können personenbezogene Daten an YouTube bzw. Google übertragen werden."
  acceptLabel="Video laden"
  containerClass={containerClass}
  mediaClass={mediaClass}
  iframeClass={iframeClass}
  iframeAllow="autoplay; encrypted-media; picture-in-picture"
/>
