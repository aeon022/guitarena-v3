---
interface Props {
  src: string;
  title: string;
  headline: string;
  description: string;
  acceptLabel?: string;
  containerClass?: string;
  mediaClass?: string;
  iframeClass?: string;
  iframeAllow?: string;
}

const {
  src,
  title,
  headline,
  description,
  acceptLabel = 'Inhalt laden',
  containerClass = '',
  mediaClass = '',
  iframeClass = '',
  iframeAllow = '',
} = Astro.props;
---

<div
  class:list={[
    'js-consent-external absolute inset-0 z-0 overflow-hidden',
    containerClass,
  ]}
  data-embed-src={src}
  data-embed-title={title}
  data-media-class={mediaClass}
  data-iframe-class={iframeClass}
  data-iframe-allow={iframeAllow}
>
  <div class="absolute inset-0 flex items-end bg-gradient-to-t from-orten-bg/80 via-orten-bg/35 to-transparent p-6 md:p-8">
    <div class="max-w-md rounded-[1.75rem] border border-orten-border bg-orten-bg/80 p-5 shadow-2xl backdrop-blur">
      <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.3em] text-orten-amber">Externer Inhalt</p>
      <h3 class="mb-3 text-2xl font-serif text-orten-text">{headline}</h3>
      <p class="text-sm leading-relaxed text-orten-muted">
        {description}
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button
          type="button"
          class="rounded-full bg-orten-amber px-5 py-3 font-mono text-[10px] uppercase tracking-[0.24em] text-orten-bg transition hover:brightness-105"
          data-accept-media
        >
          {acceptLabel}
        </button>
        <a href={import.meta.env.BASE_URL + "cookies/"} class="rounded-full border border-orten-border/50 px-5 py-3 text-center font-mono text-[10px] uppercase tracking-[0.24em] text-orten-text/75 transition hover:border-orten-amber hover:text-orten-amber">
          Mehr Infos
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const CONSENT_COOKIE_NAME = 'guitarena_consent_media';
  const CONSENT_MAX_AGE = 60 * 60 * 24 * 180;

  const readConsent = () => {
    const match = document.cookie.match(new RegExp(`(?:^|; )${CONSENT_COOKIE_NAME}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : null;
  };

  const writeConsent = (value) => {
    document.cookie = `${CONSENT_COOKIE_NAME}=${encodeURIComponent(value)}; path=/; max-age=${CONSENT_MAX_AGE}; SameSite=Lax`;
  };

  const mountEmbeds = (scope = document) => {
    if (readConsent() !== 'accepted') return;

    scope.querySelectorAll('.js-consent-external').forEach((node) => {
      if (node.dataset.loaded === 'true') return;

      const iframe = document.createElement('iframe');
      const mediaWrapper = document.createElement('div');
      const src = new URL(node.dataset.embedSrc, window.location.origin);
      if (src.hostname.includes('youtube.com') || src.hostname.includes('youtu.be')) {
        src.searchParams.set('origin', window.location.origin);
        src.searchParams.set('playsinline', '1');
      }
      iframe.src = src.toString();
      iframe.title = node.dataset.embedTitle || 'Externer Inhalt';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('frameborder', '0');
      if (node.dataset.iframeAllow) {
        iframe.setAttribute('allow', node.dataset.iframeAllow);
      }
      iframe.className = node.dataset.iframeClass || '';
      mediaWrapper.className = node.dataset.mediaClass || '';
      mediaWrapper.appendChild(iframe);
      node.innerHTML = '';
      node.appendChild(mediaWrapper);
      node.dataset.loaded = 'true';
      node.dispatchEvent(new CustomEvent('guitarena:external-embed-loaded', { bubbles: true }));
    });
  };

  const initConsentEmbeds = () => {
    document.querySelectorAll('.js-consent-external [data-accept-media]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        writeConsent('accepted');
        document.dispatchEvent(new CustomEvent('guitarena:media-consent-changed', { detail: { granted: true } }));
        mountEmbeds();
      });
    });

    mountEmbeds();
  };

  initConsentEmbeds();
  document.addEventListener('astro:after-swap', initConsentEmbeds);
  document.addEventListener('guitarena:media-consent-changed', () => mountEmbeds());
</script>
