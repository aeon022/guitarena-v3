---
import { getResponsiveImage } from '../utils/responsiveImages';
import type { GuitarenaEvent } from '../content.config';

interface Props {
  events: (GuitarenaEvent & { id: string })[];
}

const { events } = Astro.props;

const months = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const today = new Date();
today.setHours(0, 0, 0, 0);
const sortedEvents = [...events].sort((a, b) => {
  const aPast = a.date < today;
  const bPast = b.date < today;

  if (aPast !== bPast) return aPast ? 1 : -1;
  return a.date.getTime() - b.date.getTime();
});
---

<section id="programm" class="max-w-6xl w-full mx-auto px-8 md:px-16 py-24 landscape:py-16">
  <div class="mb-16 landscape:mb-10 flex flex-col md:flex-row justify-between md:items-end gap-8 landscape:gap-4 border-b border-orten-border pb-8 landscape:pb-6">
    <h2 class="text-6xl landscape:text-4xl md:text-7xl font-serif text-orten-text leading-none">
      Lineup <span class="text-4xl landscape:text-3xl md:text-5xl italic text-orten-amber ml-4 opacity-80">2026</span>
    </h2>
  </div>


  <div class="flex flex-col gap-6 landscape:gap-4">
    {sortedEvents.map(event => {
      const isPast = event.date < today;
      const imagePath = event.image
        ? (event.image.startsWith('http') ? event.image : `/images/events/${event.image}`)
        : null;
      const imageProps = getResponsiveImage(imagePath, '(min-width: 768px) 12rem, 100vw');

      return (
      <article class:list={[
        "group relative flex flex-col md:flex-row gap-6 landscape:gap-4 md:gap-10 p-6 landscape:p-4 -mx-6 rounded-2xl transition-all border border-transparent",
        isPast ? "opacity-50 hover:opacity-70" : "hover:bg-orten-card hover:border-orten-border",
      ]}>
        <a href={import.meta.env.BASE_URL + `programm/${event.id}/`} class="absolute inset-0 z-20"><span class="sr-only">Details</span></a>
        
        <div class:list={[
          "flex flex-col items-center justify-center w-20 h-24 md:w-28 md:h-32 border rounded-md shrink-0 transition-colors shadow-lg",
          isPast
            ? "border-orten-border/50 bg-orten-card/30"
            : "border-orten-border bg-orten-card group-hover:border-orten-amber group-hover:bg-orten-amber/5",
        ]}>
          <span class:list={[
            "text-xs font-mono uppercase tracking-widest",
            isPast ? "text-orten-muted" : "text-orten-amber",
          ]}>{months[event.date.getMonth()]}</span>
          <span class="text-4xl md:text-5xl font-serif text-orten-text leading-none my-2">{event.date.getDate()}</span>
          <span class="text-orten-muted text-[10px] font-mono tracking-widest">{event.date.getFullYear()}</span>
        </div>

        <div class="w-full md:w-48 h-64 md:h-auto shrink-0 overflow-hidden rounded-md relative shadow-lg">
          <div class:list={[
            "absolute inset-0 z-10 transition-opacity duration-500",
            isPast
              ? "bg-orten-bg/35"
              : "bg-orten-amber/10 mix-blend-overlay group-hover:opacity-0",
          ]}></div>
          {imageProps ? (
            <img
              src={imageProps.src}
              srcset={imageProps.srcset}
              sizes={imageProps.sizes}
              width={imageProps.width}
              height={imageProps.height}
              alt={event.title}
              loading="lazy"
              decoding="async"
              class:list={[
                "w-full h-full object-cover transition-all duration-700",
                isPast
                  ? "grayscale opacity-45"
                  : "grayscale opacity-80 group-hover:grayscale-0 group-hover:scale-105",
              ]}
            />
          ) : (
            <img
              src="https://via.placeholder.com/400x600/1c1816/e88b3a.png?text=Guitarena"
              alt={event.title}
              loading="lazy"
              decoding="async"
              class:list={[
                "w-full h-full object-cover transition-all duration-700",
                isPast
                  ? "grayscale opacity-45"
                  : "grayscale opacity-80 group-hover:grayscale-0 group-hover:scale-105",
              ]}
            />
          )}
        </div>

        <div class="flex-1 flex flex-col justify-center py-2">
          {isPast && (
            <span class="inline-flex w-fit items-center rounded-full border border-orten-border bg-orten-card/60 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.28em] text-orten-muted mb-5 landscape:mb-3">
              Schon vorbei
            </span>
          )}
          <h3 class:list={[
            "text-4xl landscape:text-3xl md:text-5xl font-serif mb-4 landscape:mb-2 transition-transform duration-300",
            isPast ? "text-orten-text/70" : "text-orten-text group-hover:translate-x-2",
          ]}>{event.title}</h3>
          <p class="text-orten-muted max-w-xl font-light leading-relaxed text-lg landscape:text-base line-clamp-2">
            {event.body}
          </p>
        </div>

        <div class="shrink-0 flex flex-col items-start md:items-end justify-center md:justify-end gap-3 md:pb-4 font-mono text-sm tracking-widest font-bold">
          <a href={import.meta.env.BASE_URL + `programm/${event.id}/`} class:list={[
            "relative z-30 transition-colors",
            isPast ? "text-orten-muted/70" : "text-orten-muted group-hover:text-orten-text",
          ]}>[ DETAILS ]</a>
          <a href="mailto:karten@porcia.at" class:list={[
            "transition-colors relative z-30",
            isPast ? "text-orten-muted/40" : "text-orten-muted/60 group-hover:text-orten-amber",
          ]}>[ TICKETS ]</a>
        </div>
      </article>
    )})}
  </div>
</section>
