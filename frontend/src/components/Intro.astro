---
// Intro.astro
---
<section class="intro-section relative overflow-hidden bg-orten-bg py-20 md:py-28 px-8 border-y border-orten-border/40">
  <div class="intro-glow absolute -top-32 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-orten-amber/10 blur-3xl" aria-hidden="true"></div>
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col md:flex-row gap-10 md:gap-16 items-start">
    <div class="intro-meta shrink-0 w-32 font-mono text-orten-amber text-[10px] uppercase tracking-[0.2em] leading-loose pt-2 border-l-2 border-orten-amber pl-4">
      <span class="whitespace-nowrap">Est. 1998</span><br>
      <span class="whitespace-nowrap">Schloss Porcia</span><br>
      <span class="whitespace-nowrap">Spittal/Drau</span>
    </div>
    <p class="intro-copy max-w-3xl text-2xl md:text-4xl font-serif text-orten-text leading-[1.25] tracking-tight">
      Zwischen alten Mauern und Gewölbebögen entsteht ein Raum für Musik von seltener Unmittelbarkeit – gespielt von einigen der herausragenden Stimmen der internationalen Gitarrenszene.
    </p>
  </div>
</section>

<style>
  .intro-section {
    isolation: isolate;
  }

  .intro-copy,
  .intro-meta {
    animation: intro-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .intro-meta {
    animation-delay: 120ms;
  }

  .intro-glow {
    animation: intro-glow 14s ease-in-out infinite;
  }

  @keyframes intro-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes intro-glow {
    0%, 100% { opacity: 0.45; transform: translateX(-50%) scale(0.9); }
    50% { opacity: 0.8; transform: translateX(-50%) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-copy,
    .intro-meta,
    .intro-glow {
      animation: none;
    }
  }
</style>
